{
  "name": "@manus-tienda/backend-perifericos",
  "version": "0.1.1-qa.3",
  "private": true,
  "bin": "dist/main.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start:dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "build:bin": "npm run build && pkg . --compress Brotli",
    "package:windows-x64": "npm run build && node scripts/package-windows-x64.mjs",
    "validate:package:windows-x64": "node scripts/validate-windows-x64-package.mjs",
    "package:linux-x64": "npm run build && node scripts/package-linux-x64.mjs",
    "validate:package:linux-x64": "node scripts/validate-linux-x64-package.mjs",
    "installer:windows-x64": "npm run package:windows-x64 && node scripts/package-windows-installer.mjs",
    "validate:installer:windows-x64": "node scripts/validate-windows-installer.mjs",
    "test": "tsx --test \"test/**/*.spec.ts\""
  },
  "pkg": {
    "assets": [
      "dist/**/*"
    ],
    "targets": [
      "node18-linux-x64",
      "node18-win-x64"
    ],
    "outputPath": "dist-bin",
    "scripts": [
      "dist/**/*.js"
    ],
    "compress": "Brotli"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.2",
    "@nestjs/core": "^10.3.2",
    "@nestjs/platform-express": "^10.3.2",
    "dotenv": "^17.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.11.19",
    "pkg": "^5.8.1",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
