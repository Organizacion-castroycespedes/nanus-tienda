PERIPHERALS_PORT=4050
PERIPHERALS_MODE=MOCK
PERIPHERALS_ENABLE_REAL_ADAPTERS=false
# RAW is the Windows ESC/POS spooler path. Set GDI only as explicit fallback;
# GDI cannot send a physical ESC/POS cut command.
PERIPHERALS_USB_PRINT_TRANSPORT=RAW
# Keep false until this queue/model has passed observed physical-cut QA.
PERIPHERALS_USB_RAW_PHYSICAL_CUT_CERTIFIED=false
PERIPHERALS_AGENT_NAME=manus-pos-peripheral-agent
PERIPHERALS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3029,http://localhost:5173
PERIPHERALS_LOG_LIMIT=500
PERIPHERALS_PRINTER_WIDTH_CHARS=48
