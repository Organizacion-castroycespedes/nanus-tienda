# ===================================
# API SERVER CONFIGURATION
# ===================================
PORT=4020
NODE_ENV=production
CORS_ORIGIN=https://yourdomain.com
APP_VERSION=release/evolutivo/0.0.1
REPORTS_API_BASE_URL=http://localhost:4021/api

# ===================================
# DATABASE - PostgreSQL
# ===================================
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=manus_tienda
DB_SSL=false
DB_LOGGING=false

# ===================================
# JWT AUTHENTICATION
# ===================================
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1h

# ===================================
# WEBHOOKS & INTEGRATIONS
# ===================================
LEADS_WEBHOOK_TOKEN=
DIAN_THIRD_PARTY_LOOKUP_ENABLED=false
DIAN_THIRD_PARTY_LOOKUP_MODE=disabled
DIAN_GET_ACQUIRER_WSDL_URL=
DIAN_GET_ACQUIRER_ENDPOINT_URL=
DIAN_CERTIFICATE_PATH=
DIAN_CERTIFICATE_PASSWORD=
DIAN_GET_ACQUIRER_TIMEOUT_MS=15000
DIAN_GET_ACQUIRER_HTTP_ENABLED=false

# ===================================
# GOOGLE DRIVE (Optional)
# ===================================
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
