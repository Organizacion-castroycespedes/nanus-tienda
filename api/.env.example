# ===================================
# API SERVER CONFIGURATION
# ===================================
PORT=4020
API_BODY_LIMIT=10mb
NODE_ENV=production
CORS_ORIGIN=https://yourdomain.com
APP_VERSION=release/evolutivo/0.0.1
REPORTS_API_BASE_URL=http://localhost:4021/api

# ===================================
# LOCAL UPLOADS
# ===================================
LOCAL_UPLOADS_DIR=../storage/uploads
MAX_PRODUCT_IMAGE_SIZE_MB=5
MAX_CATEGORY_IMAGE_SIZE_MB=5

# ===================================
# DATABASE - PostgreSQL
# ===================================
# Host run (npm run start:dev): DB_HOST=localhost
# Docker Compose local: compose injects DB_HOST=host.docker.internal
# (Postgres stays on the host). See docs/docker-local.md
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=manus_tienda
DB_SSL=false
DB_LOGGING=false

# ===================================
# JWT AUTHENTICATION
# ===================================
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1h

# ===================================
# WEBHOOKS & INTEGRATIONS
# ===================================
LEADS_WEBHOOK_TOKEN=
API_INTERNAL_TOKEN=
# Retry workers run by default. Set to false only to switch them off on purpose.
# INTEGRATION_OUTBOX_DISPATCHER_ENABLED=false
ELECTRONIC_BILLING_MODE=AUTOMATIC
INTEGRATION_OUTBOX_DISPATCHER_SCAN_INTERVAL_MS=30000
INTEGRATION_OUTBOX_DISPATCHER_BATCH_SIZE=10
INTEGRATION_OUTBOX_DISPATCHER_CONCURRENCY_LIMIT=4
INTEGRATION_OUTBOX_DISPATCHER_MAX_RETRY_ATTEMPTS=5
INTEGRATION_OUTBOX_DISPATCHER_LEASE_MS=300000
INTEGRATION_OUTBOX_DISPATCHER_INITIAL_BACKOFF_MS=30000
INTEGRATION_OUTBOX_DISPATCHER_MAX_BACKOFF_MS=1800000
INTEGRATION_OUTBOX_DISPATCHER_TIMEOUT_MS=15000
# Optional. Online POS emission waits this long for the fiscal answer (default 60000).
# INTEGRATION_OUTBOX_INLINE_TIMEOUT_MS=60000
SALE_VOID_REQUEST_WORKER_ENABLED=true
BILLING_BACKEND_INTERNAL_BASE_URL=http://localhost:4030
DIAN_THIRD_PARTY_LOOKUP_ENABLED=true
DIAN_THIRD_PARTY_LOOKUP_MODE=mock
DIAN_GET_ACQUIRER_WSDL_URL=
DIAN_GET_ACQUIRER_ENDPOINT_URL=
DIAN_CERTIFICATE_PATH=
DIAN_CERTIFICATE_PASSWORD=
DIAN_GET_ACQUIRER_TIMEOUT_MS=15000
DIAN_GET_ACQUIRER_HTTP_ENABLED=false

# ===================================
# GOOGLE DRIVE (Optional)
# ===================================
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=

# ===================================
# MANUS CONTROL CENTER (SUPER_ADMIN plataforma)
# ===================================
# Rol dedicado: ver docs/runbook-control-center-db-role.md. Host/puerto/base/SSL se toman de DB_*.
CONTROL_CENTER_ENABLED=false
CONTROL_CENTER_DB_USERNAME=
CONTROL_CENTER_DB_PASSWORD=
# Fase 2: facturacion. El worker queda apagado por defecto; el boton manual funciona igual.
CONTROL_CENTER_BILLING_WORKER_ENABLED=false
CONTROL_CENTER_BILLING_WORKER_INTERVAL_MS=3600000
CONTROL_CENTER_BILLING_LEAD_DAYS=5
CONTROL_CENTER_RECEIPT_MAX_SIZE_MB=5
# Fase 3: alertas de cobro (corren despues del worker de facturacion). Apagadas por defecto.
CONTROL_CENTER_ALERTS_ENABLED=false
CONTROL_CENTER_ALERTS_EMAIL_ENABLED=false
# SMTP (por ejemplo Brevo: smtp-relay.brevo.com, puerto 587, usuario y clave SMTP de la cuenta).
CONTROL_CENTER_SMTP_HOST=
CONTROL_CENTER_SMTP_PORT=587
CONTROL_CENTER_SMTP_SECURE=false
CONTROL_CENTER_SMTP_USER=
CONTROL_CENTER_SMTP_PASSWORD=
CONTROL_CENTER_ALERTS_FROM="MANUS POS <cobros@tu-dominio.com>"
# Instrucciones de pago del correo; usa \n para saltos de linea.
CONTROL_CENTER_PAYMENT_INSTRUCTIONS=
# Cierre: WhatsApp Cloud API de Meta (apagado por defecto; ver docs/runbook-control-center-db-role.md).
CONTROL_CENTER_WHATSAPP_ENABLED=false
CONTROL_CENTER_WHATSAPP_PHONE_NUMBER_ID=
CONTROL_CENTER_WHATSAPP_ACCESS_TOKEN=
CONTROL_CENTER_WHATSAPP_API_VERSION=v23.0
CONTROL_CENTER_WHATSAPP_TEMPLATE_LANG=es
CONTROL_CENTER_WHATSAPP_TEMPLATE_UPCOMING=manus_cobro_previo
CONTROL_CENTER_WHATSAPP_TEMPLATE_DUE=manus_cobro_vence_hoy
CONTROL_CENTER_WHATSAPP_TEMPLATE_OVERDUE=manus_cobro_vencido
# PDF del contrato: archivo opcional de clausulas ("## Titulo" y parrafos). Sin el, se usan las clausulas base.
CONTROL_CENTER_CONTRACT_TERMS_FILE=
PLATFORM_TENANT_ID=00000000-0000-0000-0000-000000000001
