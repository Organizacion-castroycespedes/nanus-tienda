NODE_ENV=development
PORT=4030
SERVICE_NAME=backend-facturacion-electronica
FISCAL_PROVIDER=MOCK_LOCAL
API_BASE_URL=http://localhost:4022
API_INTERNAL_TOKEN=

# Credential references resolve to env vars that contain JSON payloads.
# Example:
# FACTUCORE_TENANT_A={"clientKey":"example-key","clientSecret":"example-secret"}

# ===================================
# DATABASE - PostgreSQL
# ===================================
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=manus_tienda_electronic_billing
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSL=false
DB_LOGGING=false
DB_POOL_MAX=10

DIAN_WSDL_URL=
DIAN_ENDPOINT_URL=
DIAN_ALLOW_EXTERNAL_CALLS=false
DIAN_THIRD_PARTY_LOOKUP_ENABLED=true
DIAN_THIRD_PARTY_LOOKUP_MODE=mock
DIAN_GET_ACQUIRER_HTTP_ENABLED=false
DIAN_CERT_PATH=
DIAN_CERT_PASSWORD=
DIAN_ENVIRONMENT=HABILITACION
DIAN_TIMEOUT_MS=15000
DIAN_GET_ACQUIRER_ACTION=http://wcf.dian.colombia/IWcfDianCustomerServices/GetAcquirer
DIAN_WS_SECURITY_TIMESTAMP_TTL_MS=300000
LOG_LEVEL=debug

# ===================================
# ELECTRONIC BILLING BACKGROUND WORKER
# ===================================
ELECTRONIC_BILLING_BACKGROUND_ENABLED=false
ELECTRONIC_BILLING_BACKGROUND_SCAN_INTERVAL_MS=30000
ELECTRONIC_BILLING_BACKGROUND_BATCH_SIZE=10
ELECTRONIC_BILLING_BACKGROUND_MAX_RETRY_ATTEMPTS=5
ELECTRONIC_BILLING_BACKGROUND_LEASE_MS=300000
ELECTRONIC_BILLING_BACKGROUND_MANUAL_REVIEW_DELAY_MS=86400000
