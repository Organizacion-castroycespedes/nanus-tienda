{
  "name": "@manus-tienda/backend-facturacion-electronica",
  "version": "0.1.0",
  "private": true,
  "bin": "dist/main.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start:dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "build:bin": "npm run build && pkg . --compress Brotli",
    "test": "tsx --test \"test/**/*.spec.ts\""
  },
  "pkg": {
    "assets": [
      "dist/**/*"
    ],
    "targets": [
      "node18-linux-x64",
      "node18-win-x64"
    ],
    "outputPath": "dist-bin",
    "scripts": [
      "dist/**/*.js"
    ],
    "compress": "Brotli"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.2",
    "@nestjs/core": "^10.3.2",
    "@nestjs/platform-express": "^10.3.2",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.19",
    "@types/pg": "^8.23.1",
    "pkg": "^5.8.1",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
