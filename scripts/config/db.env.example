# Local-only database configuration template.
# Copy to scripts/config/db.env and replace every placeholder locally.
ENVIRONMENT=local
DB_HOST=localhost
DB_PORT=5432
DB_NAME=example_database
DB_SCHEMA=public
DB_USER=example_user
DB_PASSWORD=replace-locally
DB_ADMIN_USER=example_admin
DB_ADMIN_PASSWORD=replace-locally
SEED_SUPER_ADMIN_EMAIL=admin@example.invalid
SEED_SUPER_ADMIN_FIRST_NAME=Example
SEED_SUPER_ADMIN_LAST_NAME=User
SEED_SUPER_ADMIN_PASSWORD=replace-locally
SSH_HOST=example.invalid
SSH_PORT=22
SSH_USER=example_user
SSH_REMOTE_DIR=/replace-locally
