# =============================================================================
# Docker Compose local — backends only
# =============================================================================
# Copy this file to `.env` at the repo root (gitignored):
#   copy .env.docker.example .env
#
# Web, Postgres, peripherals and Electron stay on the host.
# See docs/docker-local.md for the full teammate onboarding runbook.
# =============================================================================

# Shared JWT — MUST match between API and reporteria
JWT_SECRET=local-docker-change-me
JWT_EXPIRES_IN=1h

# PostgreSQL on the host (not in Docker)
# From containers, compose uses host.docker.internal automatically.
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-local-postgres-password
DB_PORT=5432
DB_DATABASE=manus_tienda
DB_SSL=false

# Electronic billing DB name on the same host Postgres (same user/password)
BILLING_DB_DATABASE=manus_tienda_electronic_billing

# Optional: leave empty for local mock flows
API_INTERNAL_TOKEN=
LEADS_WEBHOOK_TOKEN=

# Local feature flags (safe defaults for Docker local)
NODE_ENV=local
INTEGRATION_OUTBOX_DISPATCHER_ENABLED=false
ELECTRONIC_BILLING_MODE=AUTOMATIC
DIAN_THIRD_PARTY_LOOKUP_MODE=mock
FISCAL_PROVIDER=MOCK_LOCAL
REPORTS_ALLOW_MOCK_AUTH=false
