# Host run: PORT can be 4100 or 4021.
# Docker Compose local forces PORT=4021 and DB_NAME=manus_tienda.
# See docs/docker-local.md
NODE_ENV=development
PORT=4021
# Host run (npm run start:dev): DB_HOST=localhost
# Docker Compose local: compose injects DB_HOST=host.docker.internal
DB_HOST=localhost
DB_PORT=5432
DB_NAME=manus_tienda
DB_USER=postgres
DB_PASSWORD=changeme
DB_SSL=false
JWT_SECRET=changeme
# Mock identity is accepted only when NODE_ENV is development or test.
REPORTS_ALLOW_MOCK_AUTH=false
CORS_ORIGIN=http://localhost:3000
