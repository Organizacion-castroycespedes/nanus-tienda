{
  "name": "@soft-manustienda/backend-reporteria",
  "version": "0.1.0",
  "private": true,
  "bin": "dist/main.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start:dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "build:bin": "npm run build && pkg . --compress Brotli"
  },
  "pkg": {
    "assets": [
      "dist/**/*",
      "node_modules/pdfmake/package.json",
      "node_modules/pdfmake/examples/fonts/**/*",
      "node_modules/@foliojs-fork/linebreak/src/**/*.trie",
      "node_modules/@foliojs-fork/pdfkit/js/data/**/*"
    ],
    "targets": [
      "node18-linux-x64",
      "node18-win-x64"
    ],
    "outputPath": "dist-bin",
    "scripts": [
      "dist/**/*.js"
    ],
    "compress": "Brotli"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.2",
    "@nestjs/core": "^10.3.2",
    "@nestjs/platform-express": "^10.3.2",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "jsonwebtoken": "^9.0.2",
    "pdfmake": "^0.2.10",
    "pg": "^8.11.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.19",
    "@types/pdfmake": "^0.2.8",
    "@types/pg": "^8.11.6",
    "pkg": "^5.8.1",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
